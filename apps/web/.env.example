# Copy to apps/web/.env.local and fill in from your Supabase project.
# See CLAUDE.md §16. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=            # Supabase Postgres connection string (pooled, port 6543)
DIRECT_URL=              # direct connection for Prisma migrations (port 5432)
DRAFT_PREVIEW_SECRET=    # signs ?draft= tokens (any long random string)
